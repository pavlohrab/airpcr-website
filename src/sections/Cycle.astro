---
import SectionHead from "../components/SectionHead.astro";
import Tag from "../components/Tag.astro";
import data from "../data/site-data.json";

const W = 1000, H = 420, ML = 52, MR = 20, MT = 20, MB = 44;
const TMAX = 76, YMIN = 25, YMAX = 110;
const x = (t: number) => ML + (t / TMAX) * (W - ML - MR);
const y = (v: number) => MT + (1 - (v - YMIN) / (YMAX - YMIN)) * (H - MT - MB);
const line = (ts: number[], vs: number[]) =>
  "M" + ts.map((t, i) => `${x(t).toFixed(1)} ${y(vs[i]).toFixed(1)}`).join("L");
const A = data.traces.air;
const B = data.traces.t100;
const series = { air: line(A.t, A.air), sample: line(A.t, A.T), t100: line(B.t, B.T) };
const yt = [30, 50, 70, 90, 110];
const xt = [0, 20, 40, 60];
---

<section class="section cycle" id="cycle" aria-labelledby="cycle-title">
  <div class="wrap">
    <SectionHead label="One cycle" title="It runs real PCR cycles, just like a lab machine." id="cycle-title">
      <p class="lead">The air swings hot and cold. The sample follows it smoothly to each temperature.</p>
    </SectionHead>

    <figure class="chart reveal">
      <div class="chart__legend mono" aria-hidden="true">
        <span class="lg lg--sample">AirPCR sample</span>
        <span class="lg lg--air">air in the loop</span>
        <span class="lg lg--ref">Bio-Rad T100 sample</span>
        <Tag source="simulated" />
      </div>
      <svg class="chart__svg draw" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="cycle-desc" data-cycle>
        <desc id="cycle-desc">
          One simulated PCR cycle. The air in AirPCR runs up to about 106 °C to heat fast and drops to about 30 °C when the
          vent opens. The sample follows smoothly through 95, 58 and 72 °C, like the sample in a Bio-Rad T100.
        </desc>
        <g class="axis">
          {
            yt.map((v) => (
              <g>
                <line x1={ML} x2={W - MR} y1={y(v)} y2={y(v)} class="gridline" />
                <text x={ML - 10} y={y(v) + 5} text-anchor="end">{v}</text>
              </g>
            ))
          }
          {xt.map((t) => <text x={x(t)} y={H - MB + 26} text-anchor="middle">{t} s</text>)}
          <text x={ML - 10} y={MT - 4} text-anchor="end" class="axis__title">°C</text>
        </g>
        <rect x={x(28)} y={MT} width={x(40) - x(28)} height={H - MT - MB} class="band" />
        <path d={series.t100} class="s s--ref" style="--len:1800;--d:200" />
        <path d={series.air} class="s s--air" style="--len:3200;--d:300" />
        <path d={series.sample} class="s s--sample" style="--len:1800;--d:500" />
        <g class="anno fade" style="--d:900">
          <text x={x(7)} y={y(106.3) - 12} class="hand-svg">air runs hot to go fast</text>
          <text x={x(41)} y={y(30) + 6} class="hand-svg hand-svg--cool">vent opens, room air rushes in</text>
        </g>
        <g class="scrub" aria-hidden="true">
          <line class="scrub__line" y1={MT} y2={H - MB} />
          <circle class="scrub__dot scrub__dot--ref" r="5" />
          <circle class="scrub__dot scrub__dot--air" r="5" />
          <circle class="scrub__dot scrub__dot--sample" r="5" />
        </g>
      </svg>
      <div class="chart__tip mono" aria-hidden="true" hidden>
        <span><b data-k="t">0</b> s</span>
        <span class="t-sample">AirPCR <b data-k="T">0</b> °C</span>
        <span class="t-air">air <b data-k="air">0</b> °C</span>
        <span class="t-ref">T100 <b data-k="ref">–</b></span>
      </div>
    </figure>
  </div>
</section>

<script>
  import data from "../data/site-data.json";
  const svg = document.querySelector<SVGSVGElement>("svg[data-cycle]");
  if (svg) {
    const A = data.traces.air;
    const B = data.traces.t100;
    const W = 1000, H = 420, ML = 52, MR = 20, MT = 20, MB = 44, TMAX = 76, YMIN = 25, YMAX = 110;
    const X = (t: number) => ML + (t / TMAX) * (W - ML - MR);
    const Y = (v: number) => MT + (1 - (v - YMIN) / (YMAX - YMIN)) * (H - MT - MB);
    const tip = svg.parentElement!.querySelector<HTMLElement>(".chart__tip")!;
    const line = svg.querySelector<SVGLineElement>(".scrub__line")!;
    const dot = (k: string) => svg.querySelector<SVGCircleElement>(`.scrub__dot--${k}`)!;
    const put = (c: SVGCircleElement, t: number, v: number | null) => {
      c.style.display = v === null ? "none" : "";
      if (v !== null) (c.setAttribute("cx", String(X(t))), c.setAttribute("cy", String(Y(v))));
    };
    const set = (k: string, v: string) => (tip.querySelector(`[data-k="${k}"]`)!.textContent = v);
    svg.addEventListener("pointermove", (e) => {
      const r = svg.getBoundingClientRect();
      const vx = ((e.clientX - r.left) / r.width) * W;
      const t = Math.max(0, Math.min(A.t[A.t.length - 1], ((vx - ML) / (W - ML - MR)) * TMAX));
      const i = Math.min(A.t.length - 1, Math.round(t / 0.5));
      const j = i < B.t.length ? i : -1;
      line.setAttribute("x1", String(X(A.t[i])));
      line.setAttribute("x2", String(X(A.t[i])));
      put(dot("sample"), A.t[i], A.T[i]);
      put(dot("air"), A.t[i], A.air[i]);
      put(dot("ref"), A.t[i], j >= 0 ? B.T[j] : null);
      set("t", A.t[i].toFixed(0));
      set("T", A.T[i].toFixed(1));
      set("air", A.air[i].toFixed(0));
      set("ref", j >= 0 ? `${B.T[j].toFixed(1)} °C` : "done");
      tip.hidden = false;
      svg.classList.add("is-scrub");
    });
    svg.addEventListener("pointerleave", () => {
      svg.classList.remove("is-scrub");
      tip.hidden = true;
    });
  }
</script>

<style>
  .chart {
    position: relative;
    display: grid;
    gap: var(--s-4);
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--bg-raise);
    border: 1px solid var(--rule);
  }
  .chart__legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    align-items: center;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }
  .lg::before {
    content: "";
    display: inline-block;
    width: 22px;
    margin-right: 8px;
    vertical-align: middle;
    border-top: 2px solid;
  }
  .lg--sample::before {
    border-color: var(--heat);
    border-top-width: 4px;
  }
  .lg--air::before {
    border-color: var(--heat);
    opacity: 0.5;
  }
  .lg--ref::before {
    border-color: var(--compare);
    border-top-width: 3px;
  }
  .chart__svg {
    width: 100%;
    height: auto;
    touch-action: pan-y;
    cursor: crosshair;
  }
  .axis text {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--muted);
  }
  .gridline {
    stroke: var(--rule);
  }
  .band {
    fill: var(--cool);
    opacity: 0.07;
  }
  .s {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .s--air {
    stroke: var(--heat);
    stroke-width: 2;
    opacity: 0.45;
  }
  .s--sample {
    stroke: var(--heat);
    stroke-width: 3.6;
    filter: drop-shadow(0 0 6px var(--heat-glow));
  }
  .s--ref {
    stroke: var(--compare);
    stroke-width: 2.6;
  }
  .hand-svg {
    font-family: var(--font-hand);
    font-size: 25px;
    fill: var(--heat);
  }
  .hand-svg--cool {
    fill: var(--cool);
  }
  .scrub {
    opacity: 0;
    transition: opacity var(--t-fast);
  }
  .chart__svg:global(.is-scrub) .scrub {
    opacity: 1;
  }
  .scrub__line {
    stroke: var(--ink-2);
    stroke-dasharray: 3 4;
  }
  .scrub__dot--air {
    fill: var(--bg);
    stroke: var(--heat);
    stroke-width: 2;
  }
  .scrub__dot--sample {
    fill: var(--heat);
  }
  .scrub__dot--ref {
    fill: var(--compare);
  }
  .chart__tip {
    position: absolute;
    top: clamp(1rem, 3vw, 2rem);
    right: clamp(1rem, 3vw, 2rem);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-4);
    padding: var(--s-2) var(--s-3);
    background: var(--surface);
    border: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .chart__tip[hidden] {
    display: none;
  }
  .chart__tip b {
    color: var(--ink);
    font-weight: 500;
  }
  .t-sample b,
  .t-air b {
    color: var(--heat);
  }
  .t-ref b {
    color: var(--compare);
  }
  @media (max-width: 640px) {
    .anno {
      display: none;
    }
    .chart__tip {
      position: static;
    }
  }
</style>
