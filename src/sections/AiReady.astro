---
import SectionHead from "../components/SectionHead.astro";
import Tag from "../components/Tag.astro";
import data from "../data/site-data.json";

// sparkline: three simulated cycles of the sample and the air, back to back
const A = data.traces.air;
const per = A.t[A.t.length - 1];
const W = 560, H = 120, P = 6;
const N = 3;
const x = (t: number) => P + (t / (per * N)) * (W - 2 * P);
const y = (v: number) => P + (1 - (v - 25) / 85) * (H - 2 * P);
const path = (vs: number[]) => {
  let d = "";
  for (let k = 0; k < N; k++)
    A.t.forEach((t, i) => (d += `${d ? "L" : "M"}${x(t + k * per).toFixed(1)} ${y(vs[i]).toFixed(1)}`));
  return d;
};
const sample = path(A.T);
const air = path(A.air);
const points = [
  { t: "Built to save every run.", d: "The full temperature curve, so you can see how your PCR went." },
  { t: "Made for AI to read.", d: "Give the run file to an AI assistant and ask whether the run went well." },
  { t: "Built for FAIR data.", d: "Findable, accessible, interoperable and reusable. Made to connect to lab software and robots." },
];
---

<section class="section ai" id="ai" aria-labelledby="ai-title">
  <div class="wrap ai__grid">
    <div>
      <SectionHead label="Open, FAIR data" title="Your run data, open and ready for AI." id="ai-title" />
      <ul class="ai__list">
        {
          points.map((p, i) => (
            <li class="reveal" style={`--i:${i}`}>
              <h3>{p.t}</h3>
              <p>{p.d}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="runfile reveal" style="--i:2" aria-label="Example of a saved run">
      <div class="runfile__bar mono">
        <span class="runfile__dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span>run_colony-pcr.json</span>
        <Tag source="planned" title="Planned feature" />
      </div>
      <svg viewBox={`0 0 ${W} ${H}`} class="runfile__spark draw" aria-hidden="true">
        <path d={air} class="sp sp--air" />
        <path d={sample} class="sp sp--sample" style="--len:4000" />
      </svg>
      <pre class="runfile__code mono"><code><span class="k">"device"</span>: <span class="s">"AirPCR"</span>,
<span class="k">"program"</span>: <span class="s">"colony PCR, 30 cycles"</span>,
<span class="k">"curves"</span>: {"{"} <span class="k">"sample"</span>: [<span class="n">72.0</span>, <span class="n">72.4</span>, …], <span class="k">"air"</span>: […] {"}"},
<span class="k">"result"</span>: <span class="s">"every step on target"</span>,
<span class="k">"license"</span>: <span class="s">"open"</span></code></pre>
      <p class="hand runfile__note" aria-hidden="true">“Was my annealing step OK?”</p>
    </figure>
  </div>
</section>

<style>
  .ai__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .ai__grid :global(.sh) {
    margin-bottom: var(--s-6);
  }
  .ai__list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-5);
  }
  .ai__list li {
    padding-left: var(--s-4);
    border-left: 2px solid var(--heat);
  }
  .ai__list h3 {
    font-size: 1.25rem;
  }
  .ai__list p {
    color: var(--ink-2);
    margin-top: var(--s-1);
  }
  .runfile {
    position: relative;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }
  .runfile__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .runfile__bar :global(.tag) {
    margin-left: auto;
  }
  .runfile__dots {
    display: flex;
    gap: 6px;
  }
  .runfile__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--rule-strong);
  }
  .runfile__spark {
    width: 100%;
    height: auto;
    padding: var(--s-4) var(--s-4) 0;
  }
  .sp {
    fill: none;
    stroke-linejoin: round;
  }
  .sp--air {
    stroke: var(--heat);
    stroke-width: 1.4;
    opacity: 0.35;
  }
  .sp--sample {
    stroke: var(--heat);
    stroke-width: 2.6;
  }
  .runfile__code {
    margin: 0;
    padding: var(--s-4);
    font-size: 0.8125rem;
    line-height: 1.7;
    white-space: pre-wrap;
    color: var(--ink-2);
  }
  .k {
    color: var(--cool);
  }
  .s {
    color: var(--heat);
  }
  .n {
    color: var(--sensor);
  }
  .runfile__note {
    position: absolute;
    right: var(--s-4);
    bottom: calc(-1 * var(--s-6));
    transform: rotate(-2deg);
  }
  @media (max-width: 900px) {
    .ai__grid {
      grid-template-columns: 1fr;
    }
    /* phones: title, then the run file, then the three points */
    .ai__grid > div {
      display: contents;
    }
    .ai__grid :global(.sh) {
      margin-bottom: 0;
    }
    .runfile {
      order: 1;
    }
    .ai__list {
      order: 2;
    }
    .runfile__note {
      position: static;
      padding: 0 var(--s-4) var(--s-4);
    }
  }
</style>
