---
// Performance: one job per graphic.
//   Left  — a comparison table (machine · tubes · time · price). Tubes live here as plain numbers.
//   Right — price vs speed scatter, emphasis form: AirPCR in ember, everything else neutral, equal dots.
// Both read from data.market (prices published, run times simulated with the same model).
import SectionHead from "../components/SectionHead.astro";
import Tag from "../components/Tag.astro";
import data from "../data/site-data.json";

const all = data.market;
const clean = (n: string) =>
  n
    .replace(" Thermal Cycler", "")
    .replace(" PCR System 96-well", "")
    .replace(" (silver block)", "")
    .replace(" (single/dual channel)", "")
    .replace(" (previous generation)", " (older)")
    .replace(" (discontinued)", "")
    .replace("Mastercycler ", "");
const makerShort = (mk: string) => mk.split(" (")[0].replace(" Scientific", "");
const nameOf = (m: (typeof all)[number]) => {
  const n = clean(m.name);
  const mk = makerShort(m.maker);
  return n.toLowerCase().includes(mk.split(" ")[0].toLowerCase()) ? n : `${mk} ${n}`;
};
const machines = all
  .map((m) => ({
    name: nameOf(m),
    type: m.group === "airpcr" ? "hot air · in development" : m.type.replace(/\s*\(.*\)$/, ""),
    group: m.group,
    us: m.group === "airpcr",
    price: m.price_usd,
    priceKind: m.group === "airpcr" ? "in parts (estimate)" : "retail",
    min: Math.round(m.fast_min),
    tubes: m.wells,
    priceSource: m.price_source,
    speedSource: m.speed_source,
  }))
  .sort((a, b) => (a.us ? -1 : b.us ? 1 : a.min - b.min));

// table: AirPCR + the machines people know; the rest behind "show all"
const featured = ["AirPCR", "Bio-Rad T100", "Eppendorf X50s", "Bento Lab Pro", "miniPCR mini16X", "miniPCR mini8X"];
const top = machines.filter((m) => featured.includes(m.name));
const rest = machines.filter((m) => !featured.includes(m.name));
const tmax = 55;
const usd = (n: number) => "$" + n.toLocaleString("en-US");

// scatter (log price)
const W = 1000, H = 560, ML = 64, MR = 24, MT = 30, MB = 60;
const P0 = Math.log10(80), P1 = Math.log10(20000);
const Y0 = 20, Y1 = 56;
const sx = (p: number) => ML + ((Math.log10(p) - P0) / (P1 - P0)) * (W - ML - MR);
const sy = (m: number) => MT + ((m - Y0) / (Y1 - Y0)) * (H - MT - MB);
// direct labels, placed where they don't hit a neighbouring dot (r = right, l = left, b = below)
const labelled: Record<string, "r" | "l" | "b"> = { AirPCR: "r", "Bio-Rad T100": "b", "miniPCR mini16X": "b", "Bento Lab Pro": "l" };
const xt = [100, 300, 1000, 3000, 10000];
const yt = [25, 35, 45, 55];
---

<section class="section perf" id="performance" aria-labelledby="perf-title">
  <div class="wrap">
    <SectionHead label="Performance" title="A few minutes slower than a lab cycler, for a fraction of the price." id="perf-title">
      <p class="lead">Lab cyclers cost $4,000 to $14,000. AirPCR's parts cost about ${data.claims.parts_usd.value}.</p>
    </SectionHead>

    <div class="perf__grid">
      <figure class="cmp reveal">
        <figcaption class="card__head">
          <span class="eyebrow">Compare the machines</span>
          <span class="tags"><Tag source="simulated" title="Run times: same physics model and protocol for every machine." /><Tag source="published" title="Retail prices as published, Nov 2026." /></span>
        </figcaption>
        <table class="cmp__table">
          <thead>
            <tr>
              <th scope="col">Machine</th>
              <th scope="col" class="num-col">Tubes</th>
              <th scope="col" class="time-col">Full PCR</th>
              <th scope="col" class="num-col">Price</th>
            </tr>
          </thead>
          <tbody class="grow">
            {
              top.map((m) => (
                <tr class:list={{ "is-us": m.us }}>
                  <th scope="row">{m.name}</th>
                  <td class="num-col num">{m.tubes ?? "–"}</td>
                  <td class="time-col">
                    <span class="tbar">
                      <span class="tbar__fill" style={`--w:${(m.min / tmax) * 100}%`} />
                    </span>
                    <span class="num">{m.min}</span>
                    <span class="unit">min</span>
                  </td>
                  <td class="num-col num">
                    {m.us ? "≈ " : ""}
                    {usd(m.price)}
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tbody class="cmp__more" hidden data-more>
            {
              rest.map((m) => (
                <tr>
                  <th scope="row">{m.name}</th>
                  <td class="num-col num">{m.tubes ?? "–"}</td>
                  <td class="time-col">
                    <span class="tbar">
                      <span class="tbar__fill" style={`--w:${(m.min / tmax) * 100}%`} />
                    </span>
                    <span class="num">{m.min}</span>
                    <span class="unit">min</span>
                  </td>
                  <td class="num-col num">{usd(m.price)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <button class="btn btn--ghost cmp__toggle" type="button" data-more-toggle aria-expanded="false">
          Show all {machines.length} machines
        </button>
        <p class="mono note">AirPCR's price is the cost of its parts; the others are retail prices.</p>
      </figure>

      <figure class="scatter reveal" style="--i:1">
        <figcaption class="card__head">
          <span class="eyebrow">Price and speed</span>
          <span class="tags"><Tag source="published" title="Retail prices as published, Nov 2026." /><Tag source="simulated" /></span>
        </figcaption>
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="sc-desc" class="scatter__svg" data-scatter>
          <desc id="sc-desc">
            Price against time for a full PCR for {machines.length} thermocyclers. Lab machines cost $4,000 to $14,000. AirPCR sits
            far to the left at about ${data.claims.parts_usd.value} in parts, a few minutes slower. The table beside it lists every machine.
          </desc>
          <g class="axis">
            {xt.map((p) => (
              <g>
                <line x1={sx(p)} x2={sx(p)} y1={MT} y2={H - MB} class="gridline" />
                <text x={sx(p)} y={H - MB + 26} text-anchor="middle">${p >= 1000 ? `${p / 1000}k` : p}</text>
              </g>
            ))}
            {yt.map((m) => <text x={ML - 10} y={sy(m) + 5} text-anchor="end">{m}</text>)}
            <text x={W - MR} y={H - 6} text-anchor="end" class="axis__title">price →</text>
            <text x={4} y={MT - 10} text-anchor="start" class="axis__title">minutes (faster is higher)</text>
          </g>
          {
            machines
              .slice()
              .sort((a, b) => Number(a.us) - Number(b.us)) // AirPCR drawn last, on top
              .map((m) => {
                const x = sx(m.price), y = sy(m.min);
                const r = m.us ? 11 : 7.5;
                const at = labelled[m.name];
                const lx = at === "r" ? x + r + 8 : at === "l" ? x - r - 8 : x;
                const ly = at === "b" ? y + r + 20 : y + 6;
                return (
                  <g class:list={["pt", `pt--${m.group}`]} data-name={m.name} data-x={x} data-y={y}>
                    <circle class="pt__dot" cx={x} cy={y} r={r} />
                    {at && (
                      <text x={lx} y={ly} text-anchor={at === "r" ? "start" : at === "l" ? "end" : "middle"}>
                        {m.us ? "AirPCR" : m.name.replace(" Pro", "")}
                      </text>
                    )}
                  </g>
                );
              })
          }
          <text x={sx(data.claims.parts_usd.value) - 10} y={sy(data.claims.fast_min.value) + 46} class="hand-svg">cost of parts</text>
          <rect class="hit" x={ML} y={MT - 20} width={W - ML - MR} height={H - MT - MB + 30} />
        </svg>
        <div class="sc-tip mono" role="tooltip" hidden data-tip>
          <p class="sc-tip__name" data-k="name"></p>
          <p class="sc-tip__type" data-k="type"></p>
          <dl>
            <dt>price</dt><dd><b data-k="price"></b> <span data-k="priceKind"></span></dd>
            <dt>full PCR</dt><dd><b data-k="min"></b> min</dd>
            <dt>tubes</dt><dd><b data-k="tubes"></b> per run</dd>
          </dl>
          <p class="sc-tip__src">Price: <span data-k="priceSource"></span><br />Time: <span data-k="speedSource"></span></p>
        </div>
        <p class="mono note">
          <span class="key key--us">AirPCR</span><span class="key key--edu">teaching / DIY</span><span class="key key--lab">lab</span>
          <span class="note__hint">Hover a dot for details.</span>
        </p>
        <script type="application/json" data-tips set:html={JSON.stringify(machines)} />
      </figure>
    </div>

    <div class="pillars">
      <article class="card reveal">
        <p class="eyebrow">Precise</p>
        <h3>Every tube within a degree of the others.</h3>
        <p class="small">A probe and a fast controller keep all sixteen tubes on target.</p>
      </article>
      <article class="card reveal" style="--i:1">
        <p class="eyebrow">Robust and repairable</p>
        <h3>Off-the-shelf parts. Nothing that wears out.</h3>
        <p class="small">No Peltier element. Every part can be bought and swapped.</p>
      </article>
      <article class="card reveal" style="--i:2">
        <p class="eyebrow">Quick</p>
        <h3>A full PCR in about {Math.round(data.claims.fast_min.value)} minutes.</h3>
        <p class="small">Air heats and cools fast, so little time is lost between steps.</p>
      </article>
    </div>
  </div>
</section>

<script>
  // "show all machines"
  const more = document.querySelector<HTMLElement>("[data-more]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-more-toggle]");
  const showAll = toggle?.textContent?.trim() ?? "";
  toggle?.addEventListener("click", () => {
    const open = more!.hidden;
    more!.hidden = !open;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.textContent = open ? "Show fewer" : showAll;
  });

  // scatter: nearest-point hover (no need to land exactly on a dot)
  const fig = document.querySelector<HTMLElement>(".scatter");
  const svg = fig?.querySelector<SVGSVGElement>("[data-scatter]");
  const tip = fig?.querySelector<HTMLElement>("[data-tip]");
  const json = fig?.querySelector<HTMLScriptElement>("[data-tips]");
  if (fig && svg && tip && json) {
    type M = { name: string; type: string; price: number; priceKind: string; min: number; tubes: number | null; priceSource: string; speedSource: string; us: boolean };
    const list: M[] = JSON.parse(json.textContent || "[]");
    const byName = new Map(list.map((m) => [m.name, m]));
    const pts = [...svg.querySelectorAll<SVGGElement>(".pt")];
    const usd = (n: number) => "$" + n.toLocaleString("en-US");
    let active: SVGGElement | null = null;

    const show = (g: SVGGElement) => {
      const m = byName.get(g.dataset.name!);
      if (!m || g === active) return;
      const set = (k: string, v: string) => (tip.querySelector(`[data-k="${k}"]`)!.textContent = v);
      set("name", m.name);
      set("type", m.type);
      set("price", (m.us ? "≈ " : "") + usd(m.price));
      set("priceKind", m.priceKind);
      set("min", String(m.min));
      set("tubes", m.tubes ? String(m.tubes) : "–");
      set("priceSource", m.priceSource || "–");
      set("speedSource", m.speedSource);
      tip.classList.toggle("is-us", m.us);
      tip.hidden = false;
      const dot = g.querySelector(".pt__dot")!.getBoundingClientRect();
      const box = fig.getBoundingClientRect();
      const tw = tip.offsetWidth, th = tip.offsetHeight;
      let x = dot.left - box.left + dot.width / 2 + 16;
      if (x + tw > box.width - 8) x = dot.left - box.left - tw - 16;
      let y = dot.top - box.top + dot.height / 2 - th / 2;
      y = Math.max(8, Math.min(box.height - th - 8, y));
      tip.style.transform = `translate(${Math.round(x)}px, ${Math.round(y)}px)`;
      active?.classList.remove("is-active");
      active = g;
      g.classList.add("is-active");
    };
    const hide = () => {
      tip.hidden = true;
      active?.classList.remove("is-active");
      active = null;
    };
    const nearest = (cx: number, cy: number) => {
      const r = svg.getBoundingClientRect();
      const k = r.width / 1000; // viewBox width
      let best: SVGGElement | null = null, bd = Infinity;
      for (const g of pts) {
        const d = Math.hypot(r.left + Number(g.dataset.x) * k - cx, r.top + Number(g.dataset.y) * k - cy);
        if (d < bd) (bd = d), (best = g);
      }
      return bd < 44 ? best : null;
    };
    svg.addEventListener("pointermove", (e) => {
      const g = nearest(e.clientX, e.clientY);
      g ? show(g) : hide();
    });
    svg.addEventListener("pointerleave", hide);
    svg.addEventListener("click", (e) => {
      const g = nearest(e.clientX, e.clientY);
      g ? show(g) : hide();
    });
    document.addEventListener("keydown", (e) => e.key === "Escape" && hide());
  }
</script>

<style>
  .perf__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-5);
  }
  .cmp,
  .scatter {
    position: relative;
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: clamp(1rem, 3vw, 2rem);
    background: var(--bg-raise);
    border: 1px solid var(--rule);
  }
  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .tags {
    display: flex;
    gap: var(--s-2);
  }
  .note {
    font-size: 0.75rem;
    color: var(--muted);
  }

  /* comparison table */
  .cmp__table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
  }
  .cmp__table th,
  .cmp__table td {
    padding: 0.6em 0.4em;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-weight: 400;
    white-space: nowrap;
  }
  .cmp__table thead th {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cmp__table tbody th {
    color: var(--ink-2);
    white-space: normal;
  }
  .cmp__table td {
    color: var(--ink);
  }
  .num-col {
    text-align: right !important;
  }
  .time-col {
    width: 42%;
  }
  .tbar {
    display: inline-block;
    width: calc(100% - 4.5em);
    height: 6px;
    margin-right: 0.5em;
    background: var(--surface-2);
    border-radius: 1px;
    vertical-align: middle;
    overflow: hidden;
  }
  .tbar__fill {
    display: block;
    height: 100%;
    width: var(--w);
    background: var(--ref);
    border-radius: 0 2px 2px 0;
    transform-origin: left;
  }
  :global(.js) .grow .tbar__fill {
    transform: scaleX(0);
    transition: transform 1s var(--ease);
  }
  :global(.js) .grow:global(.is-in) .tbar__fill {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .grow .tbar__fill {
      transform: none;
    }
  }
  .is-us th,
  .is-us td {
    color: var(--heat) !important;
    font-weight: 600;
  }
  .is-us {
    background: color-mix(in srgb, var(--heat) 8%, transparent);
  }
  .is-us .tbar__fill {
    background: var(--heat);
  }
  .cmp__toggle {
    justify-self: start;
    min-height: 36px;
    font-size: 0.75rem;
    color: var(--ink-2);
  }

  /* scatter */
  .scatter__svg {
    width: 100%;
    height: auto;
  }
  .hit {
    fill: transparent;
  }
  .axis text {
    font-family: var(--font-mono);
    font-size: 17px;
    fill: var(--muted);
  }
  .gridline {
    stroke: var(--rule);
  }
  .pt .pt__dot {
    fill: var(--ref);
    stroke: var(--bg-raise);
    stroke-width: 2; /* surface ring so overlapping dots stay separate */
    transition: r var(--t-fast) var(--ease);
  }
  .pt--edu .pt__dot {
    fill: var(--bg-raise);
    stroke: var(--ref);
    stroke-width: 2.5;
  }
  .pt--airpcr .pt__dot {
    fill: var(--heat);
    stroke: var(--bg-raise);
    filter: drop-shadow(0 0 8px var(--heat));
  }
  .pt:global(.is-active) .pt__dot {
    stroke: var(--ink);
    stroke-width: 3;
  }
  .pt text {
    font-family: var(--font-mono);
    font-size: 19px;
    fill: var(--ink-2);
    pointer-events: none;
  }
  .pt--airpcr text {
    fill: var(--heat);
    font-size: 24px;
    font-weight: 500;
  }
  .hand-svg {
    font-family: var(--font-hand);
    font-size: 28px;
    fill: var(--heat);
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-right: var(--s-4);
    color: var(--ink-2);
  }
  .key::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ref);
  }
  .key--us::before {
    background: var(--heat);
  }
  .key--edu::before {
    background: none;
    border: 2px solid var(--ref);
    width: 6px;
    height: 6px;
  }
  .note__hint {
    float: right;
  }

  .sc-tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 5;
    width: 250px;
    padding: var(--s-3) var(--s-4);
    background: var(--surface);
    border: 1px solid var(--rule-strong);
    border-left: 3px solid var(--ref);
    border-radius: var(--radius);
    box-shadow: 0 18px 40px -18px rgb(0 0 0 / 0.7);
    font-size: 0.75rem;
    color: var(--ink-2);
    pointer-events: none;
  }
  .sc-tip[hidden] {
    display: none;
  }
  .sc-tip.is-us {
    border-left-color: var(--heat);
  }
  .sc-tip__name {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .sc-tip.is-us .sc-tip__name {
    color: var(--heat);
  }
  .sc-tip__type {
    color: var(--muted);
    margin-bottom: var(--s-2);
  }
  .sc-tip dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 2px var(--s-3);
  }
  .sc-tip dt {
    color: var(--muted);
  }
  .sc-tip dd b {
    color: var(--ink);
    font-weight: 500;
  }
  .sc-tip__src {
    margin-top: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px dashed var(--rule);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-5);
    margin-top: var(--s-5);
  }
  .pillars .card {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  @media (max-width: 1080px) {
    .perf__grid,
    .pillars {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .pt text {
      display: none;
    }
    .pt--airpcr text {
      display: block;
    }
    .time-col {
      width: auto;
    }
    .tbar {
      display: none;
    }
    .note__hint {
      float: none;
      display: block;
      margin-top: 4px;
    }
  }
</style>
