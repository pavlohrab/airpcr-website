---
import AirLoop from "../components/AirLoop.astro";
import SectionHead from "../components/SectionHead.astro";

const steps = [
  { part: "heater", title: "Heater", text: "A heat-gun element warms the air." },
  { part: "mixer", title: "Mixer", text: "A mixer blends the air, so there are no hot spots." },
  { part: "straws", title: "Straws", text: "A bundle of straws calms the flow." },
  {
    part: "tubes",
    title: "Tubes",
    text: "The air sweeps past sixteen PCR tubes. One of them holds a thermal probe.",
    note: "the probe tube",
  },
  { part: "fan", title: "Fan", text: "A fan keeps the air going round." },
  { part: "flap", title: "Vent", text: "To cool down, a flap opens and lets room air in.", note: "no Peltier to wear out" },
  {
    part: "esp32",
    title: "Brain",
    text: "A microcontroller reads the probe ten times a second and steers the heater, fan and flap.",
    note: "like cruise control for heat",
  },
];
---

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="wrap">
    <SectionHead label="How it works" title="One loop of moving air." id="how-title">
      <p class="lead">Seven parts and no metal block.</p>
    </SectionHead>
  </div>

  <!-- Pinned walk-through: the track is tall, the panel inside it stays on screen,
       and scrolling through the track draws the parts one by one. -->
  <div class="how__track" style={`--steps:${steps.length}`} data-how>
    <div class="how__pin">
      <div class="wrap how__grid">
        <div class="how__stage">
          <AirLoop uid="how" />
          <div class="how__dots">
            {steps.map((s, i) => (
              <button type="button" data-go={i} aria-label={`Step ${i + 1}: ${s.title}`}>
                <span />
              </button>
            ))}
          </div>
        </div>
        <ol class="how__steps">
          {
            steps.map((s, i) => (
              <li class="how__step" data-step={s.part}>
                <span class="how__n mono">{i + 1}</span>
                <div class="how__body">
                  <h3>
                    <button type="button" class="how__go" data-go={i}>
                      {s.title}
                    </button>
                  </h3>
                  <p>{s.text}</p>
                  {s.note && (
                    <p class="hand how__note" aria-hidden="true">
                      {s.note}
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  // While the panel is pinned, the scroll position through the track picks the step (0–6)
  // and draws each part of the loop as you scroll into its step. Scrolling back un-draws it.
  // Swipes, dots and step titles only move the scroll position; update() does the rest.
  const track = document.querySelector<HTMLElement>("[data-how]");
  const svg = document.querySelector<SVGSVGElement>('svg[data-uid="how"]');
  const steps = [...document.querySelectorAll<HTMLElement>(".how__step")];
  const dots = [...document.querySelectorAll<HTMLElement>(".how__dots button")];
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (track && svg && steps.length && !still) {
    track.classList.add("is-pinned");

    // the strokes and faded bits (labels, wires, lid) that belong to each step's part
    const partsOf = (key: string) => {
      const keys = key === "tubes" ? ["tubes", "sensor"] : [key];
      const els = keys.flatMap((k) =>
        [...svg.querySelectorAll<SVGGElement>(`[data-part="${k}"]`)].flatMap((g) => [...g.querySelectorAll<SVGElement>("path, line, text")]),
      );
      return {
        strokes: els.filter((e) => e.style.getPropertyValue("--len")).map((e) => ({ e, len: parseFloat(e.style.getPropertyValue("--len")) })),
        fades: [...els.filter((e) => e.classList.contains("fade")), ...svg.querySelectorAll<SVGElement>(`[data-for="${key}"]`)],
      };
    };
    const parts = steps.map((s) => partsOf(s.dataset.step!));
    parts.forEach(({ strokes, fades }) => {
      strokes.forEach(({ e }) => (e.style.transition = "none"));
      fades.forEach((e) => (e.style.transition = "opacity 150ms linear"));
    });

    let current = -1;
    let queued = false;
    const update = () => {
      queued = false;
      const r = track.getBoundingClientRect();
      const pin = track.firstElementChild!.getBoundingClientRect();
      const top = parseFloat(getComputedStyle(track.firstElementChild!).top) || 0;
      // 0 when the panel pins, 1 when it is about to scroll away
      const p = Math.min(1, Math.max(0, (top - r.top) / Math.max(1, r.height - pin.height)));
      const t = p * steps.length; // 0 … 7
      const idx = r.top > top ? -1 : Math.min(steps.length - 1, Math.floor(t));

      // part i draws during the first 60 % of its step, starting a little early
      parts.forEach(({ strokes, fades }, i) => {
        const f = Math.min(1, Math.max(0, (t - i + 0.3) / 0.7));
        strokes.forEach(({ e, len }) => (e.style.strokeDashoffset = String(len * (1 - f))));
        fades.forEach((e) => (e.style.opacity = f > 0.6 ? "1" : "0"));
      });

      if (idx === current) return;
      current = idx;
      steps.forEach((s, i) => s.classList.toggle("is-active", i === idx));
      dots.forEach((d, i) => d.classList.toggle("is-on", i <= idx));
      if (idx >= 0) svg.dataset.focus = steps[idx].dataset.step;
      else delete svg.dataset.focus;
    };
    const onScroll = () => {
      if (!queued) (queued = true), requestAnimationFrame(update);
    };
    addEventListener("scroll", onScroll, { passive: true });
    addEventListener("resize", onScroll);
    update();

    // jump to the point where step i is fully drawn
    const pin = track.firstElementChild as HTMLElement;
    const goTo = (i: number) => {
      i = Math.min(steps.length - 1, Math.max(0, i));
      const r = track.getBoundingClientRect();
      const top = parseFloat(getComputedStyle(pin).top) || 0;
      const span = r.height - pin.offsetHeight;
      scrollTo({ top: scrollY + r.top - top + ((i + 0.75) / steps.length) * span, behavior: "smooth" });
    };
    track.querySelectorAll<HTMLElement>("[data-go]").forEach((b) => b.addEventListener("click", () => goTo(Number(b.dataset.go))));

    // a clear sideways swipe on the panel: left = next step, right = previous; vertical scrolling is untouched
    let x0 = 0, y0 = 0;
    pin.addEventListener("touchstart", (e) => ([x0, y0] = [e.touches[0].clientX, e.touches[0].clientY]), { passive: true });
    pin.addEventListener(
      "touchend",
      (e) => {
        const dx = e.changedTouches[0].clientX - x0;
        const dy = e.changedTouches[0].clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > 1.5 * Math.abs(dy)) goTo(Math.max(0, current) + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  }
</script>

<style>
  .how {
    padding-bottom: 0;
  }
  /* Pinned walk-through. --per-step is the scroll length of one step: the "speed" of the tour. */
  .how__track {
    --per-step: 55svh;
    --nav-h: 68px;
  }
  .how__track:not(.is-pinned) .how__pin {
    padding-bottom: var(--section-y);
  }
  .how__track.is-pinned {
    height: calc(100svh - var(--nav-h) + var(--steps) * var(--per-step));
    margin-bottom: var(--section-y);
  }
  .is-pinned .how__pin {
    touch-action: pan-y;
    position: sticky;
    top: var(--nav-h);
    height: calc(100svh - var(--nav-h));
    display: grid;
    align-items: center;
  }
  .how__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .how__stage {
    display: grid;
    gap: var(--s-4);
  }
  .how__dots {
    display: none;
  }
  /* step titles are buttons that jump to their step */
  .how__go {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .how__track:not(.is-pinned) .how__go {
    pointer-events: none;
  }
  .how__steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: clamp(0.5rem, 2vh, 1.25rem);
  }
  .how__step {
    display: grid;
    grid-template-columns: 2.25rem 1fr;
    gap: var(--s-3);
    opacity: 0.3;
    transition: opacity var(--t-fast) var(--ease);
  }
  .how__step.is-active,
  .how__track:not(.is-pinned) .how__step {
    opacity: 1;
  }
  .how__n {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--heat);
    border-radius: 50%;
    color: var(--heat);
    font-size: 0.8125rem;
  }
  .is-active .how__n {
    background: var(--heat);
    color: var(--bg);
  }
  .how__body {
    display: grid;
    gap: var(--s-1);
  }
  .how__body p {
    color: var(--ink-2);
    font-size: 1rem;
  }
  .how__body p.how__note {
    color: var(--heat);
    font-size: 1.25rem;
    transform: rotate(-2deg);
    transform-origin: left;
  }
  /* desktop: only the active step shows its sentence, so the list fits on one screen */
  .is-pinned .how__step:not(.is-active) .how__body p {
    display: none;
  }

  @media (max-width: 900px) {
    .how__grid {
      grid-template-columns: 1fr;
      gap: var(--s-5);
      align-content: center;
    }
    /* phones: drawing on top, then only the current step, with dots for progress */
    .how__dots {
      display: flex;
      justify-content: center;
    }
    .how__track:not(.is-pinned) .how__dots {
      display: none;
    }
    .how__dots button {
      display: grid;
      place-items: center;
      width: 26px;
      height: 26px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .how__dots span {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--rule-strong);
      transition: background var(--t-fast);
    }
    .how__dots button:global(.is-on) span {
      background: var(--heat);
    }
    .is-pinned .how__step:not(.is-active) {
      display: none;
    }
    .is-pinned .how__steps {
      min-height: 9rem;
      align-content: start;
    }
  }
</style>
