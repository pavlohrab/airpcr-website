---
// Logo options for review. Files live in public/logos/<name>-{dark,light,favicon}.svg.
import Base from "../layouts/Base.astro";
const base = import.meta.env.BASE_URL;
const options = [
  { id: "loop", name: "A · Loop", idea: "The closed air loop. The heated run glows orange. Reads as “circulation”." },
  { id: "profile", name: "B · Cycle (chosen)", idea: "One PCR cycle in a single line: hot, cold, warm. Any biologist recognises it." },
  { id: "tube", name: "C · Tube in air", idea: "A PCR tube with air streaming past it. The most literal option." },
  { id: "ring", name: "D · Three steps", idea: "One cycle as a ring: denature, anneal, extend, in the brand colours." },
];
---

<Base title="Logo options — AirPCR" description="Logo and favicon options for AirPCR.">
  <section class="section">
    <div class="wrap lg">
      <header class="lg__head">
        <p class="eyebrow">Logo options</p>
        <h1>Pick a mark.</h1>
        <p class="lead">Four simple geometric marks, each shown large, as a lockup with the name, and at favicon size.</p>
      </header>

      {
        options.map((o) => (
          <article class="opt">
            <div class="opt__meta">
              <h2>{o.name}</h2>
              <p>{o.idea}</p>
              <p class="mono opt__files">
                <a href={`${base}logos/${o.id}-dark.svg`}>dark.svg</a> · <a href={`${base}logos/${o.id}-light.svg`}>light.svg</a> ·{" "}
                <a href={`${base}logos/${o.id}-favicon.svg`}>favicon.svg</a>
              </p>
            </div>
            <div class="opt__tiles">
              <div class="tile tile--dark">
                <img src={`${base}logos/${o.id}-dark.svg`} alt="" width="120" height="120" />
              </div>
              <div class="tile tile--dark tile--lockup">
                <img src={`${base}logos/${o.id}-dark.svg`} alt="" width="44" height="44" />
                <span class="wm wm--dark">
                  <span class="wm__air">Air</span>PCR
                </span>
              </div>
              <div class="tile tile--light tile--lockup">
                <img src={`${base}logos/${o.id}-light.svg`} alt="" width="44" height="44" />
                <span class="wm wm--light">
                  <span class="wm__air">Air</span>PCR
                </span>
              </div>
              <div class="tile tile--browser">
                <span class="tab">
                  <img src={`${base}logos/${o.id}-favicon.svg`} alt="" width="16" height="16" />
                  AirPCR — PCR, made of air
                </span>
                <span class="fav-sizes">
                  <img src={`${base}logos/${o.id}-favicon.svg`} alt="" width="64" height="64" />
                  <img src={`${base}logos/${o.id}-favicon.svg`} alt="" width="32" height="32" />
                  <img src={`${base}logos/${o.id}-favicon.svg`} alt="" width="16" height="16" />
                </span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .lg {
    display: grid;
    gap: var(--s-7);
  }
  .lg__head {
    display: grid;
    gap: var(--s-4);
  }
  .opt {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--s-6);
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule);
  }
  .opt__meta {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .opt__meta h2 {
    font-size: 1.5rem;
  }
  .opt__meta p {
    color: var(--ink-2);
  }
  .opt__files {
    font-size: 0.75rem;
  }
  .opt__files a {
    color: var(--muted);
  }
  .opt__tiles {
    display: grid;
    grid-template-columns: 1fr 1.6fr 1.6fr 1.6fr;
    gap: var(--s-3);
  }
  .tile {
    display: grid;
    place-items: center;
    min-height: 170px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--rule);
  }
  .tile--dark {
    background: #0e1114;
  }
  .tile--light {
    background: #fbfcfc;
  }
  .tile--lockup {
    display: flex;
    gap: 12px;
    justify-content: center;
    align-items: center;
  }
  .wm {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 32px;
    letter-spacing: -0.035em;
  }
  .wm__air {
    font-weight: 500;
  }
  .wm--dark {
    color: #eef1f3;
  }
  .wm--dark .wm__air {
    color: #a9b2ba;
  }
  .wm--light {
    color: #14181c;
  }
  .wm--light .wm__air {
    color: #4a535c;
  }
  .tile--browser {
    background: var(--surface-2);
    display: grid;
    gap: var(--s-4);
    padding: var(--s-4);
    place-items: center;
  }
  .tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: var(--surface);
    border-radius: 8px 8px 0 0;
    font-size: 0.75rem;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .fav-sizes {
    display: flex;
    gap: 14px;
    align-items: end;
  }
  @media (max-width: 1000px) {
    .opt {
      grid-template-columns: 1fr;
    }
    .opt__tiles {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
