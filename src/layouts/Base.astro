---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "AirPCR — PCR, made of air",
  description = "AirPCR runs PCR with moving air instead of a heavy metal block: sixteen tubes, steady to within a degree, at a fraction of the cost.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "Organization", name: "AirPCR", url: Astro.site?.href, description },
    {
      "@type": "Product",
      name: "AirPCR thermocycler",
      description: "16-tube hot-air PCR thermocycler (in development; performance figures are simulated).",
      brand: { "@type": "Brand", name: "AirPCR" },
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0E1114" />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32.png`} />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const t = localStorage.getItem("airpcr-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/reveal";
    </script>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -100px;
    z-index: 100;
    padding: var(--s-2) var(--s-4);
    background: var(--heat);
    color: var(--heat-ink);
    font-family: var(--font-mono);
    font-size: var(--fs-mono);
  }
  .skip:focus {
    top: var(--s-4);
  }
</style>
